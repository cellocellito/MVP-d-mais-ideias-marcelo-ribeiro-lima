# Copie este arquivo para ".env" e ajuste se precisar.
# O .env não vai para o repositório (está no .gitignore).

# Porta da API
PORT=3000

# Banco de dados
# MariaDB instalado na máquina: porta 3306.
# MariaDB do docker-compose.yml: porta 3307.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dmais_app
# Senha de desenvolvimento, a mesma do database/schema.sql. Em produção, trocar.
DB_PASSWORD=dmais_dev_123
DB_NAME=dmais_ideias
